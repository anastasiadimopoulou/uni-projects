<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/item_background"
    android:padding="16dp"
    android:columnCount="2"
    android:rowCount="2"
    android:id="@+id/activity_update_question_managment">

    <Button
        android:id="@+id/button_create_question"
        android:layout_width="150dp"
        android:layout_height="158dp"
        android:layout_row="0"
        android:layout_rowWeight="1"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp"
        android:background="@drawable/button_background"
        android:text="Δημιουργία Eρωτήματος"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold|italic" />

    <Button
        android:id="@+id/button_delete_question"
        android:layout_width="150dp"
        android:layout_height="158dp"
        android:layout_row="0"
        android:layout_rowWeight="1"
        android:layout_column="1"
        android:layout_columnWeight="1"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp"
        android:background="@drawable/button_background"
        android:text="Διαγραφή Eρωτήματος"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold|italic" />


    <Button
        android:id="@+id/button_question_managment_back"
        android:layout_width="102dp"
        android:layout_height="58dp"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_marginBottom="32dp"
        android:background="@drawable/button_background"
        android:padding="12dp"
        android:text="Back"
        android:textColor="#FFFFFF" />


</GridLayout>
