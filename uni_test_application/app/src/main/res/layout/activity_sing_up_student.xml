<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.sing_up.Student.SingUpStudentActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="333dp"
        android:layout_height="28dp"
        android:layout_marginTop="248dp"
        android:text="complete the following fields:"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.205"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="234dp"
        android:layout_height="44dp"
        android:layout_marginTop="204dp"
        android:text="Sign up as Student"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/linearLayout3"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="0dp"
        android:layout_height="115dp"
        android:background="#3F51B5"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="VisualLintBounds">

    </LinearLayout>

    <EditText
        android:id="@+id/NameStudentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="Name"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <EditText
        android:id="@+id/SurnameStudentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="Surname"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/NameStudentText"
        app:layout_constraintTop_toBottomOf="@+id/NameStudentText" />

    <EditText
        android:id="@+id/BirtdateStudentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ems="10"
        android:hint="BirthDate"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/SurnameStudentText"
        app:layout_constraintTop_toBottomOf="@+id/SurnameStudentText" />

    <EditText
        android:id="@+id/AcademicIdStudentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ems="10"
        android:hint="Academic Id"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/BirtdateStudentText"
        app:layout_constraintTop_toBottomOf="@+id/BirtdateStudentText" />

    <EditText
        android:id="@+id/UserNameStudentText"
        android:layout_width="184dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="32dp"
        android:ems="10"
        android:hint="Username"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/UniversityStudentText" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="87dp"
        android:layout_height="86dp"
        android:layout_marginTop="116dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/linearLayout3"
        app:srcCompat="@drawable/studenticon" />

    <EditText
        android:id="@+id/passwordStudentText"
        android:layout_width="207dp"
        android:layout_height="38dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:ems="10"
        android:hint="Password"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/UniversityStudentText" />

    <Button
        android:id="@+id/btnBackStudentRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:text="Back"
        android:radius="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/UserNameStudentText" />

    <Button
        android:id="@+id/btnCreateAccountStudent"
        android:layout_width="147dp"
        android:layout_height="53dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="40dp"
        android:text="Create account"
        android:radius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passwordStudentText" />

    <EditText
        android:id="@+id/DepartmentStudentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ems="10"
        android:hint="Department"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/AcademicIdStudentText"
        app:layout_constraintTop_toBottomOf="@+id/AcademicIdStudentText" />

    <EditText
        android:id="@+id/UniversityStudentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ems="10"
        android:hint="University"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/DepartmentStudentText"
        app:layout_constraintTop_toBottomOf="@+id/DepartmentStudentText" />

</androidx.constraintlayout.widget.ConstraintLayout>